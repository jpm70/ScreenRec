{
  "appId": "com.camarasilenciosa.app",
  "appName": "CamaraSilenciosa",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#0a0a0a",
    "webContentsDebuggingEnabled": true
  },
  "plugins": {
    "Camera": {
      "permissions": ["camera", "photos"]
    },
    "Filesystem": {
      "androidExtraFilesystems": ["external-storage"]
    }
  }
}
